# Application mode (only simulation is supported in Phase 1)
APP_MODE=simulation

# LDAP Configuration
LDAP_SERVER_HOST=ccsvad05.in2p3.fr
LDAP_DOMAIN=grenoble.in2p3.fr
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_TIMEOUT_SECONDS=5

# Authenticated application session
SESSION_COOKIE_NAME=gyro_session
SESSION_TTL_SECONDS=28800
# Keep false for local HTTP development. Set true when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
