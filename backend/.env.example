# Application mode: simulation (default) or opcua_readonly
APP_MODE=simulation

# OPC UA read-only monitoring (required only when APP_MODE=opcua_readonly)
# The endpoint and node map below are non-production examples. The bundled template
# has purpose=template and is intentionally rejected until controls engineering
# supplies approved telemetry/state NodeIds, types, interpretation/polarity, and the
# copied map is marked purpose=production. Partial state maps remain UNKNOWN and
# can never prove NOMINAL; the seven telemetry mappings are still mandatory.
OPCUA_ENDPOINT_URL=opc.tcp://127.0.0.1:4840/gyrotron/
OPCUA_NODE_MAP_PATH=config/opcua_nodes.example.json
OPCUA_CONNECT_TIMEOUT_SECONDS=5
OPCUA_READ_TIMEOUT_SECONDS=3
OPCUA_MONITOR_INTERVAL_SECONDS=1
OPCUA_RECONNECT_INITIAL_SECONDS=1
OPCUA_RECONNECT_MAX_SECONDS=30
OPCUA_STALE_AFTER_SECONDS=5

# Security is never downgraded automatically. For a secure server, set both policy
# and mode and provide the required certificate/private-key paths.
OPCUA_SECURITY_POLICY=None
OPCUA_SECURITY_MODE=None
OPCUA_CLIENT_CERTIFICATE_PATH=
OPCUA_CLIENT_PRIVATE_KEY_PATH=
OPCUA_CLIENT_PRIVATE_KEY_PASSWORD=
OPCUA_SERVER_CERTIFICATE_PATH=

# Optional username/password authentication. Configure both or neither.
OPCUA_USERNAME=
OPCUA_PASSWORD=

# LDAP Configuration
LDAP_SERVER_HOST=ccsvad05.in2p3.fr
LDAP_DOMAIN=grenoble.in2p3.fr
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_TIMEOUT_SECONDS=5

# Authenticated application session
SESSION_COOKIE_NAME=gyro_session
SESSION_TTL_SECONDS=28800
# Keep false for local HTTP development. Set true when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
